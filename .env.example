# Copy to .env and paste your key. .env is gitignored; the key is read server-side only
# and is never exposed to the browser (no NEXT_PUBLIC_ prefix).
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: app attribution on openrouter.ai
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Meal Snap
